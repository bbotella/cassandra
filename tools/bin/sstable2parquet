# sstable2parquet - Convert SSTable to Parquet format

if [ "x$CASSANDRA_HOME" = "x" ]; then
    CASSANDRA_HOME="`dirname "$0"`/.."
fi

# The directory where Cassandra's configs live (required)
if [ "x$CASSANDRA_CONF" = "x" ]; then
    CASSANDRA_CONF="$CASSANDRA_HOME/conf"
fi

# The java classpath (required)
if [ "x$CLASSPATH" = "x" ]; then
    CLASSPATH="$CASSANDRA_CONF"
    for jar in "$CASSANDRA_HOME"/lib/*.jar; do
        CLASSPATH="$CLASSPATH:$jar"
    done
    # Add Hadoop and Parquet JARs from the new 'hadoop-parquet-deps' directory
    # Assuming these will be placed in $CASSANDRA_HOME/lib/hadoop-parquet-deps by the build
    for jar in "$CASSANDRA_HOME"/lib/hadoop-parquet-deps/*.jar; do
        CLASSPATH="$CLASSPATH:$jar"
    done
fi

# Java executable and options
if [ "x$JAVA" = "x" ]; then
    JAVA="java"
fi

JAVA_OPTS="$JAVA_OPTS -ea"
JAVA_OPTS="$JAVA_OPTS -Xms128M -Xmx1G" # Adjust memory as needed
JAVA_OPTS="$JAVA_OPTS -Dlogback.configurationFile=logback-tools.xml"
JAVA_OPTS="$JAVA_OPTS -Dcassandra.load_ring_state=false"
JAVA_OPTS="$JAVA_OPTS -Dcassandra.join_ring=false"
JAVA_OPTS="$JAVA_OPTS -Dcassandra.config.loader=org.apache.cassandra.config.YamlConfigurationLoader"


# JMX an JNA paths - might not be strictly needed for this offline tool but often included
# JAVA_OPTS="$JAVA_OPTS -Dcassandra.libjemalloc=jna_tmp"
# JAVA_OPTS="$JAVA_OPTS -Djava.library.path=$CASSANDRA_HOME/lib/native/"


# Main class for SSTable to Parquet conversion
MAIN_CLASS="org.apache.cassandra.tools.SSTableToParquet"

# Execute the command
exec "$JAVA" $JAVA_OPTS -cp "$CLASSPATH" "$MAIN_CLASS" "$@"
